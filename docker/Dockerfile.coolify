# Build with the repository root as context. No runtime checkout mount is needed.
FROM oven/bun:1.3.11 AS source
WORKDIR /workspace
COPY . .
RUN test -f package.json && test -f bun.lock \
    && test -f packages/realtime-server/package.json

FROM pgvector/pgvector:pg16 AS database
COPY docker/initdb/ /docker-entrypoint-initdb.d/
