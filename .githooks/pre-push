#!/usr/bin/env bash
# Local-CI gate — standalone repo layout (git root IS the project).
# One-off bypass: git push --no-verify
set -uo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

ZERO="0000000000000000000000000000000000000000"
# Deploy branches that get the Fallow code-quality gate (net-new issues only,
# grandfathered by fallow-baselines/). Pushes to any other branch skip it.
FALLOW_GATED_RE='^(staging|main)$'

pushing=0
dev_only=1
fallow_targets=()   # "base_sha branch" for each ref pushed to a deploy branch
mirror_main_sha=""
# $2 is the push destination URL.
PUBLIC_RE='github\.com[:/]SimplerDevelopment/SimplerDevelopment(\.git)?$'
target_is_public=0
if printf '%s' "${2:-}" | grep -qiE "$PUBLIC_RE"; then
  target_is_public=1
fi

while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "${local_sha:-}" ] && continue
  [ "$local_sha" = "$ZERO" ] && continue   # branch deletion
  pushing=1
  case "$remote_ref" in
    refs/heads/dev|refs/heads/dev/*) : ;;   # dev branch — relaxed below
    *) dev_only=0 ;;                         # a non-dev ref is part of this push
  esac

  if [ "$remote_sha" = "$ZERO" ] || ! git rev-parse --quiet --verify "$remote_sha^{commit}" >/dev/null 2>&1; then
    # New branch or remote_sha not present locally — base on the single commit
    fallow_base="${local_sha}^"
  else
    fallow_base="$remote_sha"
  fi

  branch="${remote_ref#refs/heads/}"
  if [[ "$branch" =~ $FALLOW_GATED_RE ]]; then
    fallow_targets+=("$fallow_base $branch")
  fi

  if [ "$branch" = "main" ]; then
    mirror_main_sha="$local_sha"
  fi

done

# Dev branches deploy immediately — local CI is intentionally skipped for a
# dev-only push so the deploy starts the moment you push. Mixed pushes (dev + a
# real branch) still run the full gate. One-off bypass: git push --no-verify
if [ "$pushing" = 1 ] && [ "$dev_only" = 1 ]; then
  echo "pre-push: dev branch only — gates relaxed, pushing immediately."
  exit 0
fi

if [ "$pushing" = 0 ]; then
  # Only deletions in this push — nothing to gate
  exit 0
fi

# Fallow code-quality gate — deploy branches (staging, main) only.
# Audits the commits being pushed against what's already on the remote, and
# blocks on NET-NEW issues; existing debt is grandfathered by fallow-baselines/.
# One-off bypass for the whole push: git push --no-verify.
if [ "${#fallow_targets[@]}" -gt 0 ]; then
  for entry in "${fallow_targets[@]}"; do
    fbase="${entry%% *}"
    fbranch="${entry##* }"
    echo "pre-push: deploy branch '$fbranch' — fallow code-quality gate (base ${fbase})…"
    if ! "$ROOT/scripts/fallow-gate.sh" "$fbase"; then
      echo "pre-push: fallow gate BLOCKED the push to '$fbranch'." >&2
      echo "          Fix the net-new issues above, or bypass once: git push --no-verify" >&2
      exit 1
    fi
  done
else
  echo "pre-push: non-deploy branch — fallow gate skipped."
fi

# The tenancy gate is CI-ONLY (moved 2026-08-20). It ran here too, on the same
# data-access path trigger, and cost ~1050s -- roughly 3x the typecheck it sat
# next to, and the single largest thing standing between a commit and a push.
#
# It was removed rather than merely narrowed because the local run is strictly
# worse than the CI job it duplicates: GitHub gives the suite an isolated
# pgvector service container, while locally it shares whatever Postgres the dev
# machine is running. In practice that produced `deadlock detected` and 60s
# `DROP DATABASE` teardown timeouts with ZERO failing assertions -- noise that
# teaches you to reach for --no-verify, which is the actual hazard.
#
# `.github/workflows/ci.yml` runs it on the same data-access paths this used to
# match. To run it by hand before pushing: `bun test:tenancy`, or
# `scripts/ci-local.sh --tenancy` (the flag is still supported).

echo "pre-push: running local CI…"
"$ROOT/scripts/ci-local.sh"
ci_status=$?
if [ "$ci_status" -ne 0 ]; then
  exit "$ci_status"
fi

# ── main-branch mirror: RETIRED 2026-08-03 ───────────────────────────────────
# Development is now public-first: this repo (SimplerDevelopment/SimplerDevelopment)
# IS the source of truth, and Vercel + the Railway agents/realtime services
# deploy from it. There is nothing to mirror TO.
#
# The old hook auto-published main to the public repo whenever main was pushed
# to the internal one. Keeping it would now be actively harmful: the internal
# repo is a frozen archive whose main still carries vault/ in 8 of its 11
# commits, so a stray push there would overwrite this repo's main with stale,
# stripped content.
#
# scripts/publish-public.sh is retained for deliberate one-off syncs out of the
# archive. It is no longer wired to run automatically.
if [ -n "$mirror_main_sha" ] && [ "$target_is_public" != 1 ]; then
  echo "pre-push: main pushed to a non-public remote — auto-mirror is retired;"
  echo "          run scripts/publish-public.sh by hand if a sync is intended."
fi

exit 0
