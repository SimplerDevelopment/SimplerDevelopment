#!/usr/bin/env bash
# Local-CI gate — standalone repo layout (git root IS the project).
# One-off bypass: git push --no-verify
set -uo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

ZERO="0000000000000000000000000000000000000000"
# Deploy branches that get the Fallow code-quality gate (net-new issues only,
# grandfathered by fallow-baselines/). Pushes to any other branch skip it.
FALLOW_GATED_RE='^(staging|main)$'

pushing=0
dev_only=1
changed=""
fallow_targets=()   # "base_sha branch" for each ref pushed to a deploy branch
mirror_main_sha=""
pushed_shas=()      # every commit being pushed, for the public-repo vault guard

# The PUBLIC repo must never receive vault/. $2 is the push destination URL.
PUBLIC_RE='github\.com[:/]SimplerDevelopment/SimplerDevelopment(\.git)?$'
target_is_public=0
if printf '%s' "${2:-}" | grep -qiE "$PUBLIC_RE"; then
  target_is_public=1
fi

while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "${local_sha:-}" ] && continue
  [ "$local_sha" = "$ZERO" ] && continue   # branch deletion
  pushing=1
  case "$remote_ref" in
    refs/heads/dev|refs/heads/dev/*) : ;;   # dev branch — relaxed below
    *) dev_only=0 ;;                         # a non-dev ref is part of this push
  esac

  if [ "$remote_sha" = "$ZERO" ] || ! git rev-parse --quiet --verify "$remote_sha^{commit}" >/dev/null 2>&1; then
    # New branch or remote_sha not present locally — diff against the single commit
    ref_changed="$(git show --name-only --format= "$local_sha" 2>/dev/null)"
    fallow_base="${local_sha}^"
  else
    ref_changed="$(git diff --name-only "$remote_sha..$local_sha" 2>/dev/null)"
    fallow_base="$remote_sha"
  fi

  changed="${changed}${ref_changed}"$'\n'

  branch="${remote_ref#refs/heads/}"
  if [[ "$branch" =~ $FALLOW_GATED_RE ]]; then
    fallow_targets+=("$fallow_base $branch")
  fi

  if [ "$branch" = "main" ]; then
    mirror_main_sha="$local_sha"
  fi

  pushed_shas+=("$local_sha")
done

# ── Public-repo vault guard ──────────────────────────────────────────────────
# Runs BEFORE local CI so it fails in seconds, not after a 30-minute gate.
#
# A pre-push hook cannot rewrite the refs being pushed, only accept or reject
# them. So a direct push of vault-bearing commits to the public repo is
# refused, and scripts/publish-public.sh is the supported path — it strips
# vault/ from the TREE, so the directory never enters public history at all.
#
# Since the 2026-08-03 split the vault is its own private repo and gitignored
# here, so this should never fire. Kept as defence in depth: it still catches a
# `git add -f` or a branch created before the split.
if [ "$target_is_public" = 1 ] && [ "${#pushed_shas[@]}" -gt 0 ]; then
  for sha in "${pushed_shas[@]}"; do
    # -z because ls-tree QUOTES paths with spaces (a plain ^vault/ match misses
    # "vault/05 - Feature Specs/..."), and grep -c rather than -q because under
    # `set -o pipefail` a -q early-exit SIGPIPEs git and makes the pipeline
    # report failure — which inverted this test in an earlier version.
    hits=$(git ls-tree -r --name-only -z "$sha" | tr '\0' '\n' | grep -c '^vault/' || true)
    if [ "${hits:-0}" -gt 0 ]; then
      echo "" >&2
      echo "pre-push: BLOCKED — commit ${sha:0:12} contains ${hits} vault/ path(s) and" >&2
      echo "          target is the PUBLIC repo." >&2
      echo "" >&2
      echo "  vault/ holds internal ADRs, domain maps, feature specs and" >&2
      echo "  security-posture notes that are deliberately not published." >&2
      echo "" >&2
      echo "  Publish a stripped snapshot instead:" >&2
      echo "      scripts/publish-public.sh ${sha:0:12}" >&2
      echo "" >&2
      exit 1
    fi
  done
  echo "pre-push: public target — no vault/ in the pushed commits."
fi

# Dev branches deploy immediately — local CI is intentionally skipped for a
# dev-only push so the deploy starts the moment you push. Mixed pushes (dev + a
# real branch) still run the full gate. One-off bypass: git push --no-verify
if [ "$pushing" = 1 ] && [ "$dev_only" = 1 ]; then
  echo "pre-push: dev branch only — gates relaxed, pushing immediately."
  exit 0
fi

if [ "$pushing" = 0 ]; then
  # Only deletions in this push — nothing to gate
  exit 0
fi

# Fallow code-quality gate — deploy branches (staging, main) only.
# Audits the commits being pushed against what's already on the remote, and
# blocks on NET-NEW issues; existing debt is grandfathered by fallow-baselines/.
# One-off bypass for the whole push: git push --no-verify.
if [ "${#fallow_targets[@]}" -gt 0 ]; then
  for entry in "${fallow_targets[@]}"; do
    fbase="${entry%% *}"
    fbranch="${entry##* }"
    echo "pre-push: deploy branch '$fbranch' — fallow code-quality gate (base ${fbase})…"
    if ! "$ROOT/scripts/fallow-gate.sh" "$fbase"; then
      echo "pre-push: fallow gate BLOCKED the push to '$fbranch'." >&2
      echo "          Fix the net-new issues above, or bypass once: git push --no-verify" >&2
      exit 1
    fi
  done
else
  echo "pre-push: non-deploy branch — fallow gate skipped."
fi

# P2: conditional tenancy gate — trigger when data-access paths changed
ci_args=""
if echo "$changed" | grep -qE "^(lib/db/|app/api/|lib/active-client\.ts)"; then
  echo "pre-push: data-access paths changed — adding tenancy gate."
  ci_args="--tenancy"
else
  echo "pre-push: no data-access changes — tenancy gate skipped."
fi

echo "pre-push: running local CI…"
# shellcheck disable=SC2086
"$ROOT/scripts/ci-local.sh" $ci_args
ci_status=$?
if [ "$ci_status" -ne 0 ]; then
  exit "$ci_status"
fi

if [ -n "$mirror_main_sha" ]; then
  # Skip when already pushing to the public repo (the guard above has already
  # cleared that push, and double-pushing the same ref races itself into a
  # stale-lock rejection).
  if [ "$target_is_public" = 1 ]; then
    echo "pre-push: push target is already the public repo — skipping mirror."
  else
    # Mirror through publish-public.sh, NOT a raw `git push` of main: main
    # carries vault/, and a raw mirror would publish it. The script strips the
    # excluded paths from the tree and fast-forwards public main.
    echo "pre-push: mirroring main to SimplerDevelopment/SimplerDevelopment (vault excluded)…"
    if ! "$ROOT/scripts/publish-public.sh" "$mirror_main_sha"; then
      echo "pre-push: mirror publish to SimplerDevelopment/SimplerDevelopment failed." >&2
      exit 1
    fi
  fi
fi

exit 0
