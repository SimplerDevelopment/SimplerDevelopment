    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^12.42.2",
    "googleapis": "^171.4.0",
    "gsap": "^3.14.2",
    "html2canvas": "^1.4.1",
    "immer": "^11.1.16",
    "jsonwebtoken": "^9.0.3",
    "jszip": "^3.10.1",
    "leaflet": "^1.9.4",
    "lenis": "^1.3.26",
    "lucide-react": "^0.563.0",
    "mousetrap": "^1.6.5",
    "next": "16.3.0",
    "next-auth": "^5.0.0-beta.30",
    "node-html-parser": "^9.0.1",
    "nodemailer": "^9.0.5",
    "octokit": "^5.0.5",
    "pdf-lib": "^1.17.1",
    "postgres": "^3.4.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-draggable": "^4.7.1",
