# SimplerDevelopment — environment template.
# Copy to .env.local and fill in. Only the "Core" block is needed to boot;
# the rest enable individual integrations and can stay blank in local dev.
# Never commit your real .env.local — it is gitignored.

# ── Core (required to run) ─────────────────────────────────────
# Postgres connection string. The schema needs the pgvector extension:
#   CREATE EXTENSION IF NOT EXISTS vector;
DATABASE_URL=postgresql://user:password@localhost:5432/simplerdev

# NextAuth (v5) session secret. Generate: openssl rand -base64 32
# AUTH_SECRET is the v5 name; NEXTAUTH_SECRET is read as a fallback.
AUTH_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Google Analytics measurement ID for the SD marketing site/app (not tenant
# sites). Leave unset to disable GA (dev/preview).
NEXT_PUBLIC_GA_ID=
# Set to true to close self-serve signup on this deployment: the signup screen
# and login-page link become "Contact us for managed hosting" and the signup
# API returns 403. Used on the hosted production environment; leave unset for
# self-host/dev where signup should work. Build-time flag (NEXT_PUBLIC_).
NEXT_PUBLIC_SIGNUP_DISABLED=
# SELF-HOSTERS: pin the session cookie to your apex domain so sign-in works and
# sessions are shared across subdomains, e.g. `.example.com`. Leave blank for
# localhost / single-host deploys (cookie stays host-only). Must start with a dot
# to cover subdomains.
AUTH_COOKIE_DOMAIN=
# OAuth consent-scope enforcement on the REST API (AUTH79-011). UNSET = log-only:
# insufficient-scope bearer requests are logged (`oauth.scope.insufficient`) but
# still allowed, so you can observe real sd_oauth_ traffic before enforcing. Set
# to 1 to actually 403 requests whose token lacks the required scope.
AUTH_SCOPE_ENFORCE=
# Session-role enforcement on newly-guarded portal routes (AUTH79-020). UNSET =
# log-only: an insufficient role on a route using observeRole is logged
# (`portal.role.insufficient`) but allowed, so real multi-member traffic can be
# observed before enforcing. Set to 1 to 403 insufficient-role requests.
AUTH_ROLE_ENFORCE=

# Shared secret that protects cron endpoints (/api/cron/*). Generate: openssl rand -hex 32
CRON_SECRET=

# ── Rate limiting (Upstash Redis) ──────────────────────────────
# Shared store that makes the auth rate limiter (lib/security/rate-limit.ts)
# global across Vercel serverless instances. WITHOUT these, the limiter falls
# back to a per-instance in-memory window (fine for local dev, weak in prod).
# Create a free Redis DB at console.upstash.com -> copy the REST URL + token.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Plugin registry / signing ──────────────────────────────────
# 32-byte base64 key used to AES-GCM-encrypt the secretEncrypted column of
# registered_app_signing_keys. Without it, plugin JWT verification falls back
# to a fixed dev key with a console.warn — UNSAFE FOR PROD. Generate: openssl rand -base64 32
PORTAL_KMS_KEY=
# Per-tenant Google Workspace credential encryption key (if using Workspace).
WORKSPACE_TENANT_SECRETS_KEY=
# AES-256-GCM key for encrypting stored integration API keys (BYOK). Required —
# the integrations API-keys route returns 500 without it. Must be 64 hex chars
# (32 bytes). Generate: openssl rand -hex 32
ENCRYPTION_KEY=
# Optional local-dev bypasses (1 = bypass).
PLUGINS_ENTITLEMENT_BYPASS=
PLUGINS_CALLBACK_ORIGIN_BYPASS=

# ── AI ─────────────────────────────────────────────────────────
# Platform-level Anthropic key (also the BYOK fallback). Required for AI features
# and for plugin jobs of kind=research-brief / draft-blog-post.
# Create at console.anthropic.com -> API keys.
ANTHROPIC_API_KEY=
# OpenAI key — used for Company Brain embeddings (text-embedding-3-small).
# Create at platform.openai.com -> API keys.
OPENAI_API_KEY=
# Signs ephemeral visitor tokens for the public chat widget (lib/chat/token.ts)
# so an unauthenticated visitor's follow-up messages stay scoped to their
# conversation. Falls back to NEXTAUTH_SECRET, then a fixed dev-only string —
# set this explicitly in production so tokens don't ride on an unrelated secret.
CHAT_TOKEN_SECRET=

# ── Mastra agents service (optional) ────────────────────────────
# Wires the standalone Mastra agents service (simplerdevelopment-agents,
# runs on port 4111) that powers the per-tenant Company Brain agent cron.
# When unset, the brain-agent cron soft-no-ops (skips its run without erroring).
SD_AGENTS_URL=
SD_AGENTS_INTERNAL_SECRET=
SD_MCP_URL=
SD_MCP_API_KEY=

# ── Realtime server (optional) ──────────────────────────────────
# Wires packages/realtime-server, the standalone Yjs WebSocket service that
# powers live multi-user collaboration on posts/decks/email campaigns in the
# visual editor. Same REALTIME_JWT_SECRET and REALTIME_INTERNAL_SECRET values
# must be set on BOTH this app and the realtime-server process — they're a
# shared secret pair, not two different credentials.
# REALTIME_JWT_SECRET: signs the collab-session token minted by
#   POST /api/realtime/token. Without it, that route returns 503
#   (collab editing is treated as disabled, not an error).
# REALTIME_INTERNAL_SECRET: authenticates this app's server-side (e.g. MCP)
#   writes to the realtime server's privileged /internal/apply endpoint, so
#   open editors update live without a refetch. Without it, that fanout is
#   skipped (logged as a warning) — the write itself still succeeds.
# REALTIME_INTERNAL_URL: base URL of the realtime server. Defaults to
#   http://localhost:3030 for local dev.
REALTIME_JWT_SECRET=
REALTIME_INTERNAL_SECRET=
REALTIME_INTERNAL_URL=

# ── Email ──────────────────────────────────────────────────────
# Local dev: docker compose starts Mailpit at SMTP :1025 and UI :8025.
# Set EMAIL_TRANSPORT=mailpit to capture outbound mail at http://localhost:8025.
# Hosted/staging/prod: leave EMAIL_TRANSPORT unset (or set resend) and provide RESEND_API_KEY.
EMAIL_TRANSPORT=
MAILPIT_SMTP_HOST=localhost
MAILPIT_SMTP_PORT=1025
# Create at resend.com -> API Keys; RESEND_FROM_EMAIL must be on a domain you
# verified in Resend (Domains tab).
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Shared secret for verifying inbound Resend webhook events (opens/clicks/
# bounces/complaints) at POST /api/email/webhooks. Get it from the Resend
# dashboard when you register that webhook endpoint. Without it, the route
# returns 401 for every event.
RESEND_WEBHOOK_SECRET=
# Shared secret for inbound-email webhook verification. Generate: openssl rand -hex 32
# Set the same value on whatever posts inbound mail to POST /api/email/inbound
# (the workers/email-inbound worker, or your provider's inbound webhook).
INBOUND_EMAIL_SECRET=

# ── Billing (Stripe) ───────────────────────────────────────────
# Keys: dashboard.stripe.com -> Developers -> API keys (use test keys locally).
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# THREE separate webhook endpoints, each with its own signing secret. In the
# Stripe dashboard (Developers -> Webhooks) register, against your deploy URL:
#   STRIPE_WEBHOOK_SECRET           -> POST /api/stripe/webhook            (platform billing/subscriptions)
#   STRIPE_ECOMMERCE_WEBHOOK_SECRET -> POST /api/stripe/webhook/ecommerce  (storefront orders)
#   STRIPE_BOOKING_WEBHOOK_SECRET   -> POST /api/stripe/webhook/booking    (booking payments)
# Local dev: `stripe listen --forward-to localhost:3000/api/stripe/webhook`
# prints a whsec_... value — use it as STRIPE_WEBHOOK_SECRET (repeat per endpoint).
STRIPE_WEBHOOK_SECRET=
STRIPE_ECOMMERCE_WEBHOOK_SECRET=
STRIPE_BOOKING_WEBHOOK_SECRET=

# ── File storage (S3-compatible) ───────────────────────────────
# Any S3-compatible store works: AWS S3, Cloudflare R2, MinIO, or a Railway
# bucket (the Railway template wires these automatically from its bucket).
# MAX_FILE_SIZE is bytes (e.g. 10485760 = 10 MB); ALLOWED_FILE_TYPES is a
# comma-separated list of MIME types. Both optional — sensible defaults apply.
#
# Local default: `docker compose up -d minio` provides local S3-compatible
# storage — endpoint http://minio:9000 (in-container) / http://localhost:9000
# (from the host), console at http://localhost:9001, credentials
# minioadmin/minioadmin, bucket simplerdev-media.
S3_ENDPOINT=
# Browser-facing endpoint for presigned URLs. SigV4 signs the request host,
# so a URL signed for an in-container endpoint (http://minio:9000) fails
# when fetched from the browser (http://localhost:9000). Set this when
# S3_ENDPOINT isn't itself publicly/browser reachable (e.g. dockerized
# MinIO); leave unset when S3_ENDPOINT is already publicly reachable.
S3_PUBLIC_ENDPOINT=
S3_REGION=
S3_BUCKET_NAME=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
MAX_FILE_SIZE=
ALLOWED_FILE_TYPES=

# ── OAuth / third-party integrations (all optional) ────────────
# For every provider below, register the callback URL against YOUR deploy
# origin (shown here as https://app.example.com; use http://localhost:3000 in dev).

# Google (Workspace integration + booking calendar + "Sign in with Google").
# Create an OAuth client at console.cloud.google.com -> APIs & Services ->
# Credentials (type: Web app). Authorized redirect URIs — ALL of:
#   https://app.example.com/api/auth/callback/google            <- login (NextAuth) — REQUIRED for "Sign in with Google"
#   https://app.example.com/api/portal/integrations/google/callback
#   https://app.example.com/api/portal/tools/booking/google/callback
# Enable the Gmail, Calendar, and Drive APIs for the project.
# NOTE: "Sign in with Google" only lights up when the id+secret are present AT
# BUILD TIME (next.config.ts computes NEXT_PUBLIC_GOOGLE_AUTH_ENABLED then), and
# it only succeeds once the /api/auth/callback/google URI above is registered on
# the OAuth client — otherwise Google returns redirect_uri_mismatch. You may set
# a dedicated login client via AUTH_GOOGLE_ID / AUTH_GOOGLE_SECRET (they take
# precedence); otherwise the GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET below are
# reused for login. See lib/auth.ts.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google Workspace (SD's own dogfood OAuth app — distinct from GOOGLE_CLIENT_ID
# above, which is login/booking). Used by lib/google/oauth.ts
# getEnvWorkspaceCredentials() for SimplerDevelopment's own Workspace connection
# flow; per-tenant enterprise credentials live in the DB instead and don't use
# these. Register a separate redirect URI on the same (or a new) OAuth client.
# Missing any of the three throws when the dogfood flow is invoked.
GOOGLE_WORKSPACE_CLIENT_ID=
GOOGLE_WORKSPACE_CLIENT_SECRET=
GOOGLE_WORKSPACE_REDIRECT_URI=
# GitHub (repo hosting integration). Create at github.com -> Settings ->
# Developer settings -> OAuth Apps. Authorization callback URL:
#   https://app.example.com/api/portal/github/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# GitHub App (site provisioning — distinct from the user-facing GITHUB_OAUTH_*
# app above). Used by lib/github.ts to create a new repo from a template under
# the simplerdevelopment org and manage collaborators when provisioning a
# client website. Create at github.com -> Settings -> Developer settings ->
# GitHub Apps, install it on the org, and copy the installation ID.
# GITHUB_APP_PRIVATE_KEY is the app's private key PEM, base64-encoded.
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY=
# Template repo new site repos are created from. Optional — defaults to
# simplerdevelopment/website-starter if unset.
GITHUB_TEMPLATE_REPO=
# Microsoft Teams (meeting ingestion). App registration at portal.azure.com ->
# Microsoft Entra ID -> App registrations. Redirect URI (Web):
#   https://app.example.com/api/portal/integrations/microsoft/callback
MICROSOFT_TEAMS_CLIENT_ID=
MICROSOFT_TEAMS_CLIENT_SECRET=
# Optional: Azure AD tenant for the OAuth authority (lib/microsoft/oauth.ts).
# Defaults to "common" (multi-tenant — any Microsoft 365 org can connect).
MICROSOFT_TEAMS_TENANT=
# LinkedIn (personal-profile posting). App at developer.linkedin.com with the
# "Sign In with LinkedIn using OpenID Connect" + "Share on LinkedIn" products.
# Authorized redirect URL:
#   https://app.example.com/api/portal/integrations/linkedin/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Optional: LinkedIn REST API version (YYYYMM). Defaults to 202606.
LINKEDIN_API_VERSION=
# Zoom (booking meeting links). Create a "General app" (user-managed OAuth) at
# marketplace.zoom.us -> Develop -> Build App. Redirect URL:
#   https://app.example.com/api/portal/tools/booking/zoom/callback
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
# E-signature (Dropbox Sign). API key at app.hellosign.com -> Settings -> API.
DROPBOX_SIGN_API_KEY=
# OAuth CSRF state-nonce secret. Generate: openssl rand -hex 32
OAUTH_STATE_SECRET=
# Google Cloud API key (server-side key, not OAuth). Used today by the
# visual-editor font picker (/api/google-fonts); one key can serve additional
# key-based Google Cloud APIs. Without it the font-picker endpoint returns 503.
# Create one in Google Cloud Console -> APIs & Services -> Credentials, enable
# "Web Fonts Developer API", and restrict it by API / HTTP referrer.
GOOGLE_API_KEY=
# Brandfetch (auto-fills a tenant's brand profile — logo, colors — from their
# domain during onboarding, lib/branding/brandfetch.ts). API key at
# brandfetch.io -> Developers. Best-effort: without it, enrichment is silently
# skipped and the brand profile keeps its blank defaults — nothing errors.
BRANDFETCH_API_KEY=
# Cloudflare (DNS automation for client site subdomains/CNAMEs during website
# provisioning, lib/cloudflare-dns.ts). API token at dash.cloudflare.com ->
# My Profile -> API Tokens (needs Zone:DNS:Edit on your zone); Zone ID is on
# the zone's Overview page. Without these, any DNS-record call throws.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# ── Contact / email overrides ───────────────────────────────────
# Override platform contact addresses without changing source code.
CONTACT_INBOX=info@simplerdevelopment.com
BILLING_EMAIL=billing@simplerdevelopment.com
SUPPORT_EMAIL=support@simplerdevelopment.com
NEXT_PUBLIC_CONTACT_EMAIL=info@simplerdevelopment.com
