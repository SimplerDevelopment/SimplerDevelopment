# Your SimplerDevelopment site ID (portal → Websites)
NEXT_PUBLIC_SITE_ID=

# API key for reading this site's content (portal → Developer).
# SECRET — no NEXT_PUBLIC_ prefix, so it stays server-side. lib/sd.ts throws if
# it is ever imported into the browser.
SD_API_KEY=

# API base URL. Override for local development against a dev portal.
SD_API_URL=https://simplerdevelopment.com
